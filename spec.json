{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Bar chart with blinking D column.",
  "width": "container",
  "height": 400,
  "signals": [
    {
      "name": "blink",
      "init": 1,
      "on": [
        {
          "events": [{"type": "timer", "interval": 500}],
          "update": "1 - blink"
        }
      ]
    }
  ],
  "data": {
    "values": [
      {"category": "A", "value": 28},
      {"category": "B", "value": 55},
      {"category": "C", "value": 43},
      {"category": "D", "value": 91},
      {"category": "E", "value": 81},
      {"category": "F", "value": 53},
      {"category": "G", "value": 19},
      {"category": "H", "value": 87}
    ]
  },
  "layer": [
    {
      "mark": "bar",
      "transform": [{"filter": "datum.category != 'D'"}],
      "encoding": {
        "x": {"field": "category", "type": "nominal", "axis": {"labelAngle": 0}, "title": "Category"},
        "y": {"field": "value", "type": "quantitative", "title": "Value"},
        "color": {"field": "category", "type": "nominal", "legend": null},
        "opacity": {"value": 1}
      }
    },
    {
      "mark": "bar",
      "transform": [{"filter": "datum.category == 'D'"}],
      "encoding": {
        "x": {"field": "category", "type": "nominal"},
        "y": {"field": "value", "type": "quantitative"},
        "color": {"value": "#1f77b4"},
        "opacity": {"signal": "blink"}
      }
    }
  ]
}
