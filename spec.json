{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Bar chart with blinking D column.",
  "width": "container",
  "height": 400,
  "signals": [
    {
      "name": "blink",
      "init": 1
    }
  ],
  "data": {
    "values": [
      {"category": "A", "value": 28},
      {"category": "B", "value": 55},
      {"category": "C", "value": 43},
      {"category": "D", "value": 91},
      {"category": "E", "value": 81},
      {"category": "F", "value": 53},
      {"category": "G", "value": 19},
      {"category": "H", "value": 87}
    ]
  },
  "mark": "bar",
  "encoding": {
    "x": {"field": "category", "type": "nominal", "axis": {"labelAngle": 0}, "title": "Category"},
    "y": {"field": "value", "type": "quantitative", "title": "Value"},
    "color": {"field": "category", "type": "nominal", "legend": null},
    "opacity": {
      "condition": {"test": "datum.category === 'D'", "signal": "blink"},
      "value": 1
    }
  }
}
